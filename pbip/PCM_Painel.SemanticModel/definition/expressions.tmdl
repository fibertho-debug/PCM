expression fNormalizaNP =
		// Normaliza NP: troca NBSP/tab/quebra por espaço, colapsa espaços repetidos, apara as pontas e põe em MAIÚSCULAS.
		// Espaço INTERNO simples é preservado (existem NPs legítimos como "MLTU S09").
		// Espelho de norm_np() em fase0/scripts/extrair_e_auditar.py.
		(t as nullable text) as nullable text =>
		let
		    a = if t = null then null else
		        Text.Replace(Text.Replace(Text.Replace(Text.Replace(t, "#(00A0)", " "), "#(tab)", " "), "#(lf)", " "), "#(cr)", " "),
		    partes = if a = null then {} else List.Select(Text.Split(a, " "), each _ <> ""),
		    r = Text.Upper(Text.Combine(partes, " "))
		in
		    if r = "" then null else r
	lineageTag: 59fe9c1a-7c2b-4c7c-a555-91e7849749d8

expression fNormalizaNS =
		// Limpeza de NS: apenas espaços/NBSP (NÃO muda caixa nem reescreve o formato).
		// O formato canônico do NS ainda NÃO foi definido pela equipe (ver LEIA-ME). Use fNSForaDoPadrao para sinalizar.
		(t as nullable text) as nullable text =>
		let
		    a = if t = null then null else
		        Text.Replace(Text.Replace(Text.Replace(Text.Replace(t, "#(00A0)", " "), "#(tab)", " "), "#(lf)", " "), "#(cr)", " "),
		    partes = if a = null then {} else List.Select(Text.Split(a, " "), each _ <> ""),
		    r = Text.Combine(partes, " ")
		in
		    if r = "" then null else r
	lineageTag: 923569c0-515e-48d9-bf46-bd6ddd0be80f

expression fNSForaDoPadrao =
		// TRUE quando o NS não segue o padrão PROVISÓRIO "NS-" + dígitos (ex.: NS-01).
		// Só sinaliza; não corrige. Troque a regra aqui quando o padrão for definido.
		(ns as nullable text) as logical =>
		let
		    s = fNormalizaNS(ns),
		    resto = if s = null then "" else Text.AfterDelimiter(s, "NS-"),
		    ok = s <> null and Text.StartsWith(s, "NS-") and resto <> ""
		         and List.AllTrue(List.Transform(Text.ToList(resto), each _ >= "0" and _ <= "9"))
		in
		    not ok
	lineageTag: 17ec81c4-ac14-460b-a5a2-5e30ebb87e20

expression fParseData =
		// Converte texto dd/mm/aaaa (estrito, após trim) em date. Qualquer outro formato -> null (nunca adivinha).
		// Ex.: "27/0/2024", "17/02/23", "08/042024", "06-07-2023" viram null e ficam visíveis como "sem data".
		// Espelho de parse_data_txt().
		(t as nullable text) as nullable date =>
		let
		    s = if t = null then null else Text.Trim(Text.Replace(t, "#(00A0)", " ")),
		    formatoOk = s <> null and Text.Length(s) = 10 and Text.At(s, 2) = "/" and Text.At(s, 5) = "/",
		    r = if formatoOk then try Date.FromText(s, [Format = "dd/MM/yyyy", Culture = "pt-BR"]) otherwise null else null
		in
		    r
	lineageTag: 683b8721-3a03-4916-942e-823c60335011

expression fParseStatusManutencao =
		// Extrai Vencimento e END do texto livre de "Status manutenção".
		//   "Venc.: 26/12/2022 / END.: 01/03/2023"  -> [Venc = 26/12/2022, END = 01/03/2023]
		//   "Previsão de Venc.: 26/12/2022"          -> [Venc = 26/12/2022, END = null]
		//   "Prev.: 04/01/2022", "Prazo: ..."        -> null/null (é previsão de manutenção, NÃO vencimento)
		// Requer fParseData. Espelho de parse_status_manutencao().
		(t as nullable text) as record =>
		let
		    s = if t = null then "" else Text.Replace(t, "#(00A0)", " "),
		    apos = (marcador as text) as nullable date =>
		        let p = Text.PositionOf(s, marcador, Occurrence.First)   // sensível a maiúsculas: "END" não casa "pendente"
		        in if p < 0 then null
		           else fParseData(Text.Start(Text.Trim(Text.AfterDelimiter(Text.Middle(s, p), ":")), 10)),
		    venc = apos("Venc"),
		    fim  = apos("END")
		in
		    [Venc = venc, END = fim]
	lineageTag: bff6d2bb-c518-441a-8254-4b635d90181a

